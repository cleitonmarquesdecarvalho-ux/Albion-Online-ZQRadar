<!DOCTYPE html>
<html>
<head>
    <title>ZQRadar Drawing</title>
    <style>
        body{
            background-color: #121317;
        }
        
        /* Position the canvases, with the topCanvas above the gridCanvas */
        #mapCanvas {
            position: absolute;
            top: 0;
            left: 0;
            margin: 10px;
        }

        #gridCanvas {
            position: absolute;
            top: 0;
            left: 0;
            margin: 10px;
            border: 2px solid grey;
        }

        #drawCanvas {
            position: absolute;
            top: 0;
            left: 0;
            margin: 10px;
        }

        #ourPlayerCanvas {
            position: absolute;
            top: 0;
            left: 0;
            margin: 10px;
        }

        #button {
            position: absolute;
            top: 10px;
            background-color: #1a1c23;
            color:white;
            margin: 10px;
            border: 1px solid gray;
            padding: 8px 18px;
            cursor: pointer;
            left: 1040px;
        }

        #logEnemiesList {
            position: absolute;
            top: 50px;
            background-color: #1a1c23;
            color:white;
            margin: 10px;
            border: 1px solid gray;
            padding: 8px 18px;
            cursor: pointer;
            left: 1040px;
        }

        #playersPanel {
            position: absolute;
            top: 12px;
            left: 12px;
            z-index: 10;
            width: min(205px, calc(100vw - 44px));
            max-height: min(330px, calc(100vh - 48px));
            overflow-y: auto;
            padding: 8px;
            border: 1px solid rgba(150, 154, 165, .75);
            border-radius: 6px;
            background: rgba(20, 22, 28, .9);
            box-shadow: 0 3px 14px rgba(0, 0, 0, .55);
            backdrop-filter: blur(3px);
            color: #f3f4f6;
            font: 13px Arial, sans-serif;
        }

        .player-card {
            padding: 6px 3px;
            border-bottom: 1px solid #3a3d45;
        }

        .player-name { font-weight: 700; }
        .player-meta { margin-top: 3px; color: #b8bbc4; font-size: 12px; }
        .player-hostile { border-left: 3px solid #ff5555; padding-left: 8px; }
        .faction-hostile { color: #ff7777; font-weight: 700; }
        .player-alert {
            margin: 8px 0;
            padding: 8px;
            border: 1px solid #ff5555;
            border-radius: 4px;
            background: #4a1d24;
            color: #fff;
            font-weight: 700;
            animation: alert-pulse 1s ease-in-out 3;
        }
        @keyframes alert-pulse { 50% { background: #8d202d; } }

        #canvasContainer {
            position: relative;
            min-width: 1150px;
            min-height: 540px;
        }

        #thirdCanvas {
   
            position: absolute;
            top: 0;
     
            margin: 10px;
            bottom: 0;
            left: 520px;
            border: 2px solid grey;
        }

        @media (max-width: 1100px) {
            #canvasContainer { min-width: 700px; min-height: 1040px; }
            #thirdCanvas { top: 520px; left: 0; }
            #button, #logEnemiesList { left: 520px; }
        }
    </style>
</head>
<body>
    <div id="canvasContainer">
        <canvas id="mapCanvas" width="500" height="500"></canvas>
        <canvas id="gridCanvas" width="500" height="500"></canvas>
        <canvas id="drawCanvas" width="500" height="500"></canvas>
        <canvas id="ourPlayerCanvas" width="500" height="500"></canvas>
        <canvas id="thirdCanvas" width="500" height="500" ></canvas>
        <button id="button">Clear</button>
        <button id="logEnemiesList">Log Enemies List</button>
        <section id="playersPanel" aria-live="polite">
            <strong id="playersCount">Players detected (0)</strong>
            <div class="player-meta">Jogadores detectados, equipamento, vida e montaria.</div>
            <div id="playerAlert" class="player-alert" role="status" hidden></div>
            <div id="playersList"><div class="player-meta">Aguardando eventos de jogadores…</div></div>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/3.1.10/signalr.min.js" ></script>
    <script src="/scripts/Handlers/HarvestablesHandler.js"></script>
    <script src="/scripts/Handlers/MobsHandler.js"></script>
    <script src="/scripts/Handlers/ChestsHandler.js"></script>
    <script src="/scripts/Handlers/DungeonsHandler.js"></script>  
    <script src="/scripts/Handlers/Map.js"></script>  
    <script src="/scripts/Handlers/MobsInfo.js"></script>
    <script src="/scripts/Handlers/ItemsInfo.js"></script>
    <script src="/scripts/Handlers/FactionFlagInfo.js"></script>
    <script src="/scripts/Utils/DrawingUtils.js"></script>
    <script src="/scripts/Utils/Settings.js"></script>
    
    <script type="module" src="/scripts/Utils/Utils.js"></script> 
</body>
</html>
